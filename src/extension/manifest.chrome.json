{
  "manifest_version": 3,
  "name": "GM Tools for VTT",
  "description": "An AI side-panel assistant for virtual tabletop game masters, with Roll20 integration.",
  "homepage_url": "https://github.com/ysobolev/gmtools",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "identity",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://app.roll20.net/*",
    "https://openrouter.ai/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open GM Tools for VTT"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://app.roll20.net/editor/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
