{
  "manifest_version": 3,
  "name": "GM Tools for Roll20",
  "description": "An AI side-panel assistant for Roll20 game masters.",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "identity", "storage", "scripting"],
  "host_permissions": [
    "https://app.roll20.net/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open GM Tools"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://app.roll20.net/editor/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
