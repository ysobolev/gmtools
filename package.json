{
  "name": "gmtools",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm typecheck && node scripts/build.mjs",
    "firefox:lint": "pnpm build && web-ext lint --source-dir extension-firefox",
    "firefox:run": "pnpm build && web-ext run --source-dir extension-firefox",
    "firefox:package": "pnpm build && web-ext build --source-dir extension-firefox --overwrite-dest",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "check": "pnpm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "web-ext": "^10.6.0"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "5.0.33",
    "@ai-sdk/react": "^4.0.87",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.84",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4"
  }
}
